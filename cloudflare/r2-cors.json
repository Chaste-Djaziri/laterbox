{
  "rules": [
    {
      "id": "laterbox-app-uploads",
      "allowed": {
        "origins": [
          "*"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT",
          "POST",
          "DELETE"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "x-amz-*"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
