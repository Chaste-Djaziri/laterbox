# LaterBox Web — Whop checkout settings
# Copy these variable names into laterbox-web/.env.local for local Next.js development.
# NEVER commit real values. This file intentionally contains no credentials.
# Use sandbox credentials and sandbox plan IDs until real checkout tests pass.
WHOP_SANDBOX=true
WHOP_COMPANY_ID=
WHOP_COMPANY_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLUS_MONTHLY_PLAN_ID=
WHOP_PLUS_YEARLY_PLAN_ID=
WHOP_VAULT_MONTHLY_PLAN_ID=
WHOP_VAULT_YEARLY_PLAN_ID=

# Production (Cloudflare Worker "laterbox-web"):
# - Store WHOP_COMPANY_API_KEY and WHOP_WEBHOOK_SECRET as encrypted Worker Secrets.
# - Set WHOP_SANDBOX=false and the four plan IDs in the production Worker environment.
# - Do not add WHOP_COMPANY_API_KEY to any NEXT_PUBLIC_ variable.
# - Supabase Edge secrets are a separate runtime; the Next.js checkout route
#   does not automatically receive secrets stored there.

# Bootstrap two products and four billing plans automatically (dry-run by default):
# npm run whop:provision
# For testing after setting key/company ID: npm run whop:provision -- --apply --sandbox
# Live plans require an explicit confirmation:
# WHOP_CONFIRM_PRODUCTION=CREATE_LIVE_CATALOG npm run whop:provision -- --apply --production
# The script updates WHOP_*_PLAN_ID values in the ignored .env.local; don't commit credentials.

# Diagnose the live Whop catalog without creating anything (uses existing API key):
# npm run whop:provision -- --inspect --production
# The Whop API expects account_id for all product/plan list and create requests.
# WHOP_COMPANY_ID is still the configuration variable for the biz_... account ID.
