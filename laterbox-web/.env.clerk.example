# Supply these to the build environment. Keep rollout disabled until setup is verified.
NEXT_PUBLIC_CLERK_AUTH_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server secrets: configure privately in Cloudflare and an untracked local env file.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=https://laterbox.dev,https://www.laterbox.dev,https://app.laterbox.dev
# Use the existing Supabase project and service key. Do not disable legacy Auth.
NEXT_PUBLIC_SUPABASE_URL=https://ltjisrgldssqskcylcbj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# For localhost, use pk_test_/sk_test_ and a separate development Supabase project.
# Add that development instance to its Supabase third-party integrations.
# Register its exact issuer in auth_provider_issuers in that development database.
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# CLERK_JWT_ISSUER=https://your-development-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://app.localhost:3000
