/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "laterbox-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "laterbox-web"
		}
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "laterbox.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.laterbox.dev",
			"custom_domain": true
		},
		{
			"pattern": "docs.laterbox.dev",
			"custom_domain": true
		},
		{
			"pattern": "app.laterbox.dev",
			"custom_domain": true
		}
	],
	"upload_source_maps": true,
	"vars": {
		"IOS_GEMINI_FALLBACK_ENABLED": "true",
		"MODEL": "gemini-3.5-flash-lite",
		"WHOP_COMPANY_ID": "biz_VzpmkYvhtl23Ma",
		"WHOP_PLUS_MONTHLY_PLAN_ID": "plan_xHUtJJyIKLpLU",
		"WHOP_PLUS_YEARLY_PLAN_ID": "plan_e52tpQuj8D86e",
		"WHOP_SANDBOX": "false",
		"WHOP_VAULT_MONTHLY_PLAN_ID": "plan_zedik0IB8wVaz",
		"WHOP_VAULT_YEARLY_PLAN_ID": "plan_BJQnA897vsZpY",
		"WHOP_PLUS50_MONTHLY_PLAN_ID": "plan_eqKzcvPxQeNjC",
		"WHOP_PLUS50_YEARLY_PLAN_ID": "plan_PAr2qgdyrrGGJ",
		"WHOP_VAULT250_MONTHLY_PLAN_ID": "plan_GwxkaSjb7bmTT",
		"WHOP_VAULT250_YEARLY_PLAN_ID": "plan_HeIkWcvPqrpgh",
		"WHOP_VAULT500_MONTHLY_PLAN_ID": "plan_mvAhgWv9Jxfsm",
		"WHOP_VAULT500_YEARLY_PLAN_ID": "plan_354JRUA2vhDlC",
		"WHOP_VAULT1TB_MONTHLY_PLAN_ID": "plan_C1Qbsh7wX2Njr",
		"WHOP_VAULT1TB_YEARLY_PLAN_ID": "plan_4mF2Q4DlERgQE",
		"WHOP_VAULT2TB_MONTHLY_PLAN_ID": "plan_Pu4NVn48HX3Vt",
		"WHOP_VAULT2TB_YEARLY_PLAN_ID": "plan_Ar6OXWGUEvYNa",
		"EARN_TRACKING_ENABLED": "false"
	}
}