{
  "name": "laterbox-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bump": "node scripts/bump-version.js",
    "whop:provision": "tsx scripts/provision-whop-catalog.ts",
    "start": "next start",
    "lint": "eslint src scripts next.config.ts open-next.config.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:sync-secrets": "node scripts/cloudflare-production.mjs sync-secrets",
    "cf:deploy-production": "node scripts/cloudflare-production.mjs deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test": "tsx --test src/**/*.test.ts scripts/*.test.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@opennextjs/cloudflare": "^1.19.9",
    "@paddle/paddle-js": "^1.4.2",
    "@supabase/supabase-js": "^2.112.3",
    "@videojs/react": "^10.0.1",
    "@whop/elements": "^1.9.0",
    "@whop/elements-react": "^1.9.0",
    "@whop/sdk": "^2.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.33.0",
    "next": "16.2.11",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5.7.4",
    "wrangler": "^4.125.0"
  }
}
