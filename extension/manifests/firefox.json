{
  "manifest_version": 3,
  "name": "LaterBox - Save for Later",
  "description": "Save the current page to laterbox.",
  "version": "1.0.43",
  "browser_specific_settings": {
    "gecko": {
      "id": "laterbox@micorp.pro",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "identity",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "http://127.0.0.1:54321/*",
    "http://localhost:54321/*"
  ],
  "action": {
    "default_title": "Save to laterbox",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_title": "laterbox",
    "default_panel": "src/sidepanel/sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "save-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Save current page to laterbox"
    },
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open laterbox side panel"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
