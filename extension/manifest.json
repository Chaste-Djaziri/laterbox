{
  "manifest_version": 3,
  "name": "LaterBox",
  "description": "Save the current page to LaterBox.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "http://127.0.0.1:54321/*",
    "http://localhost:54321/*"
  ],
  "action": {
    "default_title": "Save to LaterBox",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
