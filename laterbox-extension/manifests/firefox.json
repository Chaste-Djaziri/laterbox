{
  "manifest_version": 3,
  "name": "LaterBox - Save for Later",
  "description": "Save pages, readable articles, social posts, and source-linked highlights to your LaterBox Pro account.",
  "version": "1.0.176",
  "browser_specific_settings": {
    "gecko": {
      "id": "laterbox@micorp.pro",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "identity",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "http://127.0.0.1:54321/*",
    "http://localhost:54321/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Save to laterbox",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_title": "laterbox",
    "default_panel": "src/sidepanel/sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "save-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save current page to LaterBox"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Save selected text with its source highlight"
    },
    "_execute_sidebar_action": {
      "description": "Open LaterBox side panel"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
